<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SubRelay</AssemblyName>
    <RootNamespace>SubRelay</RootNamespace>
    <Version>1.0.0</Version>
    <!-- WPF owns DPI awareness; Windows Forms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SubRelay.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/SubRelay.ico" />
    <Resource Include="Assets/SubRelay-32.png" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
