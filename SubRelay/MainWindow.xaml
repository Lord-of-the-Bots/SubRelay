<Window x:Class="SubRelay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sub Relay" Width="580" MinWidth="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="#F6F4F0"
        FontFamily="Segoe UI" FontSize="13" Foreground="#242723">
    <StackPanel Margin="20,16,20,16">
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/SubRelay-32.png" Width="28" Height="28" Margin="0,0,9,0" />
                    <TextBlock Text="Sub Relay" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{DynamicResource Introduction}" Foreground="#686D64" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="SettingsButton" Width="30" Height="30" Padding="4"
                    VerticalAlignment="Top" Click="OpenSettingsClicked" Background="Transparent"
                    ToolTip="{DynamicResource Settings}" AutomationProperties.Name="{DynamicResource Settings}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="17" />
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CloseToTrayBox" Header="{DynamicResource CloseToTray}" IsCheckable="True" Click="SettingsChanged" />
                        <MenuItem x:Name="StartWithWindowsBox" Header="{DynamicResource StartWithWindows}" IsCheckable="True" Click="SettingsChanged" />
                        <MenuItem x:Name="LanguageMenu" Header="{DynamicResource Language}">
                            <MenuItem Header="{DynamicResource SystemLanguage}" Tag="system" IsCheckable="True" Click="LanguageChanged" />
                            <Separator />
                            <MenuItem Header="Русский" Tag="ru" IsCheckable="True" Click="LanguageChanged" />
                            <MenuItem Header="English" Tag="en" IsCheckable="True" Click="LanguageChanged" />
                            <MenuItem Header="Português (Brasil)" Tag="pt-BR" IsCheckable="True" Click="LanguageChanged" />
                            <MenuItem Header="Español" Tag="es" IsCheckable="True" Click="LanguageChanged" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Exit}" Click="ExitClicked" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>
        <Border BorderBrush="#DDDAD3" BorderThickness="0,1,0,0" Padding="0,11,0,13">
            <StackPanel>
                <TextBlock Text="{DynamicResource SourceHeading}" FontSize="11" Foreground="#686D64" />
                <TextBlock x:Name="SourceLabel" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorLabel" Foreground="#A45127" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
        <ScrollViewer x:Name="SubwooferScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SubwooferCards" />
        </ScrollViewer>
        <Grid Margin="0,2,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="AddSubwooferButton" Content="{DynamicResource AddSubwoofer}" Click="AddSubwooferClicked"
                    Background="Transparent" HorizontalAlignment="Left" Margin="-7,0,0,0" />
            <Button x:Name="PauseButton" Grid.Column="1" Content="{DynamicResource Pause}" Click="PauseClicked"
                    Background="#DF602D" Foreground="White" Padding="18,7" MinWidth="100" FontWeight="SemiBold"
                    ToolTip="{DynamicResource PauseHelp}" />
        </Grid>
        <TextBlock Text="{DynamicResource LevelNote}" FontSize="11" Foreground="#686D64" TextWrapping="Wrap"
                   ToolTip="{DynamicResource LevelHelp}" ToolTipService.ShowDuration="20000" />
        <TextBlock Text="{DynamicResource SetupHelp}" FontSize="11" Foreground="#686D64" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>
</Window>
